# Copy to app/.env.local (git-ignored) and fill in. Read at build time.
# Fine-grained GitHub token: Repository access = only iumer/sakinah-feedback,
# Permissions = Contents: Read and write. Nothing else.
EXPO_PUBLIC_FEEDBACK_TOKEN=
EXPO_PUBLIC_FEEDBACK_REPO=iumer/sakinah-feedback
EXPO_PUBLIC_FEEDBACK_FILE=REPORTS.md
